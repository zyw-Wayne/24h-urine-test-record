    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "antd-mobile": "^5.37.0",
    "chart.js": "^4.4.4",
    "dayjs": "^1.11.13",
    "dexie": "^3.2.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
